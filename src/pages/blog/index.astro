---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const posts = await getCollection('blog', ({ data }) => !data.draft);
const sortedPosts = posts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const featuredPost = sortedPosts[0];
const remainingPosts = sortedPosts.slice(1);

const categories = ['All', 'Shoe Care', 'Footwear Brand History'];
---

<BaseLayout title="Blog" description="Expert advice on shoe care, fashion trends, and the stories behind footwear brands.">
  <!-- Hero -->
  <section class="blog-hero">
    <div class="container">
      <span class="badge">Our Blog</span>
      <h1>Style Tips & <span class="highlight">Insights</span></h1>
      <p class="hero-desc">
        Expert advice on shoe care, fashion trends, and the stories behind
        our craft.
      </p>
    </div>
  </section>

  <!-- Featured Post -->
  {featuredPost && (
    <section class="section">
      <div class="container">
        <a href={`/blog/${featuredPost.id}`} class="featured-card">
          <div class="featured-image">
            {featuredPost.data.heroImage ? (
              <img src={featuredPost.data.heroImage} alt={featuredPost.data.title} width="800" height="400" loading="eager" />
            ) : (
              <span aria-hidden="true">📝</span>
            )}
          </div>
          <div class="featured-content">
            <div class="featured-meta">
              <span class="badge">{featuredPost.data.category}</span>
              <time>{featuredPost.data.pubDate.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}</time>
            </div>
            <h2>{featuredPost.data.title}</h2>
            <p>{featuredPost.data.description}</p>
            <span class="read-more">Read Article →</span>
          </div>
        </a>
      </div>
    </section>
  )}

  <!-- Category Filter -->
  <section class="section section-alt">
    <div class="container">
      <div class="filter-bar">
        {categories.map(cat => (
          <button class={`filter-btn ${cat === 'All' ? 'active' : ''}`} data-category={cat}>{cat}</button>
        ))}
      </div>

      <!-- Blog Grid -->
      <div class="blog-grid" id="blog-grid">
        {remainingPosts.map(post => (
          <a href={`/blog/${post.id}`} class="blog-card" data-category={post.data.category}>
            <div class="blog-card-image">
              {post.data.heroImage ? (
                <img src={post.data.heroImage} alt={post.data.title} width="400" height="220" loading="lazy" />
              ) : (
                <span aria-hidden="true">📝</span>
              )}
            </div>
            <div class="blog-card-content">
              <div class="blog-card-meta">
                <span class="badge">{post.data.category}</span>
                <time>{post.data.pubDate.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })}</time>
              </div>
              <h3>{post.data.title}</h3>
              <p>{post.data.description}</p>
            </div>
          </a>
        ))}
      </div>

      {sortedPosts.length === 0 && (
        <div class="empty-state">
          <span>📭</span>
          <h3>No posts yet</h3>
          <p>Check back soon for new content!</p>
        </div>
      )}
    </div>
  </section>
</BaseLayout>

<script>
  const filterBtns = document.querySelectorAll('.filter-btn');
  const cards = document.querySelectorAll('.blog-card');

  filterBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      filterBtns.forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      const category = btn.getAttribute('data-category');
      cards.forEach(card => {
        if (category === 'All' || card.getAttribute('data-category') === category) {
          (card as HTMLElement).style.display = '';
        } else {
          (card as HTMLElement).style.display = 'none';
        }
      });
    });
  });
</script>

<style>
  .blog-hero {
    padding: var(--space-4xl) 0;
    background: linear-gradient(135deg, var(--color-bg) 0%, var(--color-bg-alt) 100%);
    text-align: center;
  }

  .blog-hero h1 {
    font-size: 3rem;
    margin: var(--space-lg) 0;
  }

  .highlight {
    color: var(--color-primary);
  }

  .hero-desc {
    max-width: 600px;
    margin: 0 auto;
    font-size: 1.1rem;
    color: var(--color-text-light);
  }

  /* Featured Card */
  .featured-card {
    display: grid;
    grid-template-columns: 1fr 1fr;
    background: var(--color-bg-card);
    border-radius: var(--radius-xl);
    overflow: hidden;
    border: 1px solid var(--color-border-light);
    text-decoration: none;
    transition: all var(--transition-base);
    margin-bottom: var(--space-2xl);
  }

  .featured-card:hover {
    box-shadow: var(--shadow-xl);
    transform: translateY(-2px);
  }

  .featured-image {
    height: 350px;
    background: var(--color-bg-alt);
    overflow: hidden;
  }

  .featured-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--transition-slow);
  }

  .featured-card:hover .featured-image img {
    transform: scale(1.03);
  }

  .featured-content {
    padding: var(--space-2xl);
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .featured-meta {
    display: flex;
    align-items: center;
    gap: var(--space-md);
    margin-bottom: var(--space-lg);
  }

  .featured-meta time {
    font-size: 0.85rem;
    color: var(--color-text-muted);
  }

  .featured-content h2 {
    font-size: 1.6rem;
    margin-bottom: var(--space-md);
    line-height: 1.3;
    color: var(--color-text);
  }

  .featured-content p {
    color: var(--color-text-light);
    font-size: 0.95rem;
    margin-bottom: var(--space-lg);
  }

  .read-more {
    color: var(--color-primary);
    font-weight: 600;
    font-size: 0.95rem;
  }

  /* Filter Bar */
  .filter-bar {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
    justify-content: center;
    margin-bottom: var(--space-2xl);
  }

  .filter-btn {
    padding: var(--space-sm) var(--space-xl);
    border-radius: var(--radius-full);
    background: var(--color-bg-card);
    border: 1px solid var(--color-border);
    color: var(--color-text-light);
    font-size: 0.9rem;
    font-weight: 500;
    cursor: pointer;
    transition: all var(--transition-fast);
  }

  .filter-btn:hover,
  .filter-btn.active {
    background: var(--color-primary);
    color: white;
    border-color: var(--color-primary);
  }

  /* Blog Grid */
  .blog-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-xl);
  }

  .blog-card {
    display: flex;
    flex-direction: column;
    background: var(--color-bg-card);
    border-radius: var(--radius-lg);
    overflow: hidden;
    border: 1px solid var(--color-border-light);
    text-decoration: none;
    transition: all var(--transition-base);
  }

  .blog-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-xl);
  }

  .blog-card-image {
    height: 200px;
    background: var(--color-bg-alt);
    overflow: hidden;
  }

  .blog-card-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--transition-slow);
  }

  .blog-card:hover .blog-card-image img {
    transform: scale(1.05);
  }

  .blog-card-content {
    padding: var(--space-xl);
    flex: 1;
    display: flex;
    flex-direction: column;
  }

  .blog-card-meta {
    display: flex;
    align-items: center;
    gap: var(--space-md);
    margin-bottom: var(--space-md);
  }

  .blog-card-meta time {
    font-size: 0.8rem;
    color: var(--color-text-muted);
  }

  .blog-card h3 {
    font-size: 1.15rem;
    margin-bottom: var(--space-md);
    color: var(--color-text);
    line-height: 1.3;
    flex: 1;
  }

  .blog-card p {
    font-size: 0.9rem;
    color: var(--color-text-light);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .empty-state {
    text-align: center;
    padding: var(--space-4xl);
    color: var(--color-text-muted);
  }

  .empty-state span {
    font-size: 4rem;
    display: block;
    margin-bottom: var(--space-lg);
  }

  @media (max-width: 768px) {
    .blog-hero h1 {
      font-size: 2rem;
    }

    .featured-card {
      grid-template-columns: 1fr;
    }

    .featured-image {
      height: 200px;
    }

    .blog-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
