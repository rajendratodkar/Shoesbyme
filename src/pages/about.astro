---
import BaseLayout from '../layouts/BaseLayout.astro';

const timeline = [
  { year: '2023', title: 'Founded', description: 'Started with a passion for sharing shoe knowledge and brand histories.' },
  { year: '2024', title: 'Growth', description: 'Expanded to cover 70+ footwear brands and comprehensive care guides.' },
  { year: 'Today', title: 'Community', description: 'Building a community of shoe enthusiasts who appreciate quality footwear.' },
];

const missions = [
  { icon: '📚', title: 'Knowledge First', description: 'We research and share detailed brand histories, care techniques, and industry insights.' },
  { icon: '🔍', title: 'In-Depth Research', description: 'Every article is thoroughly researched to provide accurate and valuable information.' },
  { icon: '❤️', title: 'Community Driven', description: 'We respond to reader questions and cover topics that matter to shoe enthusiasts.' },
];
---

<BaseLayout title="About" description="Discover the story behind ShoesByMe — a blog dedicated to shoe knowledge, brand histories, and care tips.">
  <!-- Hero -->
  <section class="about-hero">
    <div class="container">
      <span class="badge">About Us</span>
      <h1>Your Source for <span class="highlight">Shoe Knowledge</span></h1>
      <p class="hero-desc">
        Discover the story behind ShoesByMe — a blog dedicated to shoe knowledge,
        brand histories, and care tips.
      </p>
    </div>
  </section>

  <!-- Timeline -->
  <section class="section">
    <div class="container">
      <div class="section-header">
        <h2>Our Journey</h2>
        <p>From a simple idea to a comprehensive shoe knowledge resource.</p>
      </div>
      <div class="timeline">
        {timeline.map((item, index) => (
          <div class={`timeline-item ${index % 2 === 0 ? 'left' : 'right'}`}>
            <div class="timeline-marker">{item.year}</div>
            <div class="timeline-content">
              <h3>{item.title}</h3>
              <p>{item.description}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Mission -->
  <section class="section section-alt">
    <div class="container">
      <div class="section-header">
        <h2>Our Mission</h2>
        <p>We believe understanding shoes deepens appreciation for craftsmanship and quality.</p>
      </div>
      <div class="grid grid-3">
        {missions.map(mission => (
          <div class="mission-card">
            <span class="mission-icon">{mission.icon}</span>
            <h3>{mission.title}</h3>
            <p>{mission.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Founder -->
  <section class="section">
    <div class="container">
      <div class="founder-grid">
        <div class="founder-image">
          <div class="founder-avatar" role="img" aria-label="Rajendra Todkar, Founder">
            <span aria-hidden="true">✍️</span>
          </div>
        </div>
        <div class="founder-content">
          <span class="badge">About Us</span>
          <h2>Rajendra Todkar</h2>
          <p class="founder-role">Author & Shoe Enthusiast</p>
          <blockquote class="founder-quote">
            "Hello, shoe lovers! My name is Rajendra Todkar, and I am excited to share my experiences with you about one of my favorite topics — shoes. At ShoesByMe, we have a major focus on telling people about the history of every shoe brand. We believe that understanding a brand's roots, inspirations, and innovations can deepen our appreciation for their products and their impact on the shoe industry."
          </blockquote>
          <p>
            As an author and shoe enthusiast, Rajendra has had the pleasure of exploring a wide range of shoe brands over the years. ShoesByMe covers shoe brand history, from classic leather dress shoes to trendy sneakers and everything in between.
          </p>
          <a href="/blog" class="btn btn-primary">Read Our Blog</a>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="cta-banner">
    <div class="container">
      <div class="cta-content">
        <h2>Explore Our Content</h2>
        <p>Discover brand histories, care tips, and everything about shoes.</p>
        <a href="/blog" class="btn btn-primary btn-lg">Start Reading</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .about-hero {
    padding: var(--space-4xl) 0;
    background: linear-gradient(135deg, var(--color-bg) 0%, var(--color-bg-alt) 100%);
    text-align: center;
  }

  .about-hero h1 {
    font-size: 3rem;
    margin: var(--space-lg) 0;
  }

  .highlight {
    color: var(--color-primary);
  }

  .hero-desc {
    max-width: 600px;
    margin: 0 auto;
    font-size: 1.1rem;
    color: var(--color-text-light);
  }

  .section-header {
    text-align: center;
    margin-bottom: var(--space-3xl);
  }

  .section-header h2 {
    margin-bottom: var(--space-md);
  }

  .section-header p {
    color: var(--color-text-light);
    max-width: 600px;
    margin: 0 auto;
  }

  /* Timeline */
  .timeline {
    position: relative;
    max-width: 800px;
    margin: 0 auto;
  }

  .timeline::before {
    content: '';
    position: absolute;
    left: 50%;
    top: 0;
    bottom: 0;
    width: 2px;
    background: var(--color-border);
    transform: translateX(-50%);
  }

  .timeline-item {
    display: flex;
    align-items: center;
    margin-bottom: var(--space-2xl);
    position: relative;
  }

  .timeline-item.left {
    flex-direction: row;
    padding-right: calc(50% + 40px);
    text-align: right;
  }

  .timeline-item.right {
    flex-direction: row-reverse;
    padding-left: calc(50% + 40px);
    text-align: left;
  }

  .timeline-marker {
    position: absolute;
    left: 50%;
    transform: translateX(-50%);
    width: 80px;
    height: 80px;
    background: var(--color-primary);
    color: white;
    border-radius: var(--radius-full);
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 700;
    font-family: var(--font-heading);
    font-size: 0.9rem;
    z-index: 1;
  }

  .timeline-content h3 {
    margin-bottom: var(--space-sm);
  }

  .timeline-content p {
    color: var(--color-text-light);
    font-size: 0.95rem;
  }

  /* Mission Cards */
  .mission-card {
    background: var(--color-bg-card);
    border-radius: var(--radius-lg);
    padding: var(--space-2xl);
    border: 1px solid var(--color-border-light);
    text-align: center;
  }

  .mission-icon {
    font-size: 3rem;
    display: block;
    margin-bottom: var(--space-lg);
  }

  .mission-card h3 {
    margin-bottom: var(--space-md);
  }

  .mission-card p {
    color: var(--color-text-light);
  }

  /* Founder */
  .founder-grid {
    display: grid;
    grid-template-columns: 300px 1fr;
    gap: var(--space-3xl);
    align-items: center;
  }

  .founder-avatar {
    width: 250px;
    height: 250px;
    background: linear-gradient(135deg, var(--color-accent-light) 0%, var(--color-accent) 100%);
    border-radius: var(--radius-full);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 8rem;
    margin: 0 auto;
  }

  .founder-role {
    color: var(--color-primary);
    font-weight: 600;
    margin-bottom: var(--space-lg);
  }

  .founder-quote {
    border-left: 4px solid var(--color-accent);
    padding-left: var(--space-lg);
    margin: var(--space-xl) 0;
    font-style: italic;
    color: var(--color-text);
    font-size: 1.05rem;
  }

  /* CTA */
  .cta-banner {
    background: linear-gradient(135deg, var(--color-primary) 0%, var(--color-primary-dark) 100%);
    padding: var(--space-4xl) 0;
    text-align: center;
  }

  .cta-content h2 {
    color: white;
    margin-bottom: var(--space-md);
  }

  .cta-content p {
    color: rgba(255, 255, 255, 0.9);
    margin-bottom: var(--space-xl);
  }

  @media (max-width: 768px) {
    .about-hero h1 {
      font-size: 2rem;
    }

    .timeline::before {
      left: 40px;
    }

    .timeline-item.left,
    .timeline-item.right {
      flex-direction: row;
      padding-right: 0;
      padding-left: 100px;
      text-align: left;
    }

    .timeline-marker {
      left: 40px;
      width: 60px;
      height: 60px;
      font-size: 0.75rem;
    }

    .founder-grid {
      grid-template-columns: 1fr;
      text-align: center;
    }
  }
</style>
