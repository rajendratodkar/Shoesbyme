<BaseLayout title="Terms & Conditions" description="ShoesByMe terms and conditions — rules governing the use of our website and content.">
  <section class="policy-hero">
    <div class="container">
      <h1>Terms & Conditions</h1>
      <p class="last-updated">Last updated: January 1, 2024</p>
    </div>
  </section>

  <section class="section">
    <div class="container container-narrow">
      <div class="prose">
        <h2>1. Acceptance of Terms</h2>
        <p>
          By accessing and using the ShoesByMe website (shoesbyme.com), you agree
          to be bound by these Terms and Conditions. If you do not agree to these
          terms, please do not use our website.
        </p>

