---
const currentYear = new Date().getFullYear();

const footerLinks = {
  browse: [
    { label: 'Blog', href: '/blog' },
    { label: 'Size Guide', href: '/size-guide' },
  ],
  company: [
    { label: 'About Us', href: '/about' },
    { label: 'Contact', href: '/contact' },
    { label: 'FAQ', href: '/faq' },
  ],
  legal: [
    { label: 'Privacy Policy', href: '/privacy-policy' },
    { label: 'Terms & Conditions', href: '/terms-and-conditions' },
    { label: 'Disclaimer', href: '/disclaimer' },
  ],
};
---

<footer class="footer">
  <div class="container">
    <div class="footer-grid">
      <div class="footer-brand">
        <a href="/" class="footer-logo">
          <img src="/images/shoesbyme-logo.webp" alt="ShoesByMe" width="160" height="40" class="footer-logo-img" />
        </a>
        <p class="footer-tagline">Step Into Your Style</p>
        <p class="footer-desc">Your trusted source for shoe knowledge, care tips, and brand history.</p>
        <div class="social-links">
          <a href="#" aria-label="Facebook" class="social-link">FB</a>
          <a href="#" aria-label="Instagram" class="social-link">IG</a>
          <a href="#" aria-label="Twitter" class="social-link">TW</a>
          <a href="#" aria-label="Pinterest" class="social-link">PT</a>
        </div>
      </div>

      <div class="footer-links-group">
        <h4>Browse</h4>
        <ul>
          {footerLinks.browse.map(link => (
            <li><a href={link.href}>{link.label}</a></li>
          ))}
        </ul>
      </div>

      <div class="footer-links-group">
        <h4>Company</h4>
        <ul>
          {footerLinks.company.map(link => (
            <li><a href={link.href}>{link.label}</a></li>
          ))}
        </ul>
      </div>

      <div class="footer-links-group">
        <h4>Legal</h4>
        <ul>
          {footerLinks.legal.map(link => (
            <li><a href={link.href}>{link.label}</a></li>
          ))}
        </ul>
      </div>

      <div class="footer-newsletter">
        <h4>Stay Updated</h4>
        <p>Subscribe for the latest shoe knowledge and style tips.</p>
        <form class="newsletter-form" id="newsletter-form">
          <label for="newsletter-email" class="sr-only">Email address</label>
          <input type="email" id="newsletter-email" name="email" placeholder="Your email" class="newsletter-input" required />
          <button type="submit" class="btn btn-accent btn-sm">Subscribe</button>
        </form>
        <p class="newsletter-status" id="newsletter-status" aria-live="polite"></p>
      </div>
    </div>

    <div class="footer-bottom">
      <p>&copy; {currentYear} Shoesbyme. All Rights Reserved.</p>
    </div>
  </div>
</footer>

<script>
  const API_URL = import.meta.env.PUBLIC_NEWSLETTER_API_URL || 'https://api.shoesbyme.com';

  const form = document.getElementById('newsletter-form');
  const status = document.getElementById('newsletter-status');
  if (form && status) {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const email = form.querySelector('input')?.value?.trim();
      if (!email) return;
      status.textContent = 'Submitting...';
      status.style.color = 'var(--color-graphite)';
      try {
        const res = await fetch(`${API_URL}/subscribe`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ email }),
        });
        const data = await res.json().catch(() => ({}));
        if (res.ok) {
          status.textContent = 'Thank you for subscribing!';
          status.style.color = '#4A7C59';
          form.reset();
        } else {
          status.textContent = data.error || 'Something went wrong. Please try again.';
          status.style.color = '#C44536';
        }
      } catch {
        status.textContent = 'Network error. Please try again.';
        status.style.color = 'var(--color-error, #C44536)';
      }
      setTimeout(() => { status.textContent = ''; }, 5000);
    });
  }
</script>

<style>
  .footer {
    background: var(--color-carbon);
    color: var(--color-fog);
    padding: var(--spacing-80) 0 var(--spacing-24);
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 2fr 1fr 1fr 1fr 2fr;
    gap: var(--spacing-32);
    margin-bottom: var(--spacing-40);
  }

  .footer-logo {
    display: flex;
    align-items: center;
    gap: var(--spacing-8);
    text-decoration: none;
    margin-bottom: var(--spacing-16);
  }

  .footer-logo:hover {
    opacity: 0.7;
  }

  .footer-logo-img {
    height: 34px;
    width: auto;
    display: block;
    filter: brightness(0) invert(1);
  }

  .footer-tagline {
    color: var(--color-stone);
    font-weight: var(--font-weight-medium);
    font-size: var(--text-body-sm);
    margin-bottom: var(--spacing-12);
  }

  .footer-desc {
    color: var(--color-graphite);
    font-size: var(--text-body-sm);
    margin-bottom: var(--spacing-20);
    line-height: var(--leading-body-sm);
  }

  .social-links {
    display: flex;
    gap: var(--spacing-10);
  }

  .social-link {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    border-radius: var(--radius-icons);
    background: var(--color-graphite-smoke);
    color: var(--color-fog);
    font-size: 11px;
    font-weight: var(--font-weight-semibold);
    text-decoration: none;
    transition: background var(--transition-fast);
  }

  .social-link:hover {
    background: var(--color-signal-blue);
  }

  .footer-links-group h4 {
    color: var(--color-paper);
    font-family: var(--font-inter);
    font-size: var(--text-body-sm);
    font-weight: var(--font-weight-semibold);
    margin-bottom: var(--spacing-16);
  }

  .footer-links-group ul {
    list-style: none;
  }

  .footer-links-group li {
    margin-bottom: var(--spacing-10);
  }

  .footer-links-group a {
    color: var(--color-graphite);
    font-size: var(--text-body-sm);
    text-decoration: none;
    transition: color var(--transition-fast);
  }

  .footer-links-group a:hover {
    color: var(--color-paper);
  }

  .footer-newsletter h4 {
    color: var(--color-paper);
    font-family: var(--font-inter);
    font-size: var(--text-body-sm);
    font-weight: var(--font-weight-semibold);
    margin-bottom: var(--spacing-12);
  }

  .footer-newsletter p {
    color: var(--color-graphite);
    font-size: var(--text-body-sm);
    margin-bottom: var(--spacing-16);
  }

  .newsletter-form {
    display: flex;
    gap: var(--spacing-8);
  }

  .newsletter-input {
    flex: 1;
    padding: var(--spacing-10) var(--spacing-12);
    border: 1px solid var(--color-graphite-smoke);
    border-radius: var(--radius-cards);
    background: var(--color-surface-dark);
    color: var(--color-paper);
    font-size: var(--text-body-sm);
    font-family: var(--font-inter);
  }

  .newsletter-input::placeholder {
    color: var(--color-stone);
  }

  .newsletter-input:focus {
    outline: none;
    border-color: var(--color-paper);
  }

  .newsletter-status {
    color: var(--color-stone);
    font-size: var(--text-caption);
    margin-top: var(--spacing-8);
    min-height: 1.2em;
  }

  .footer-bottom {
    border-top: 1px solid var(--color-graphite-smoke);
    padding-top: var(--spacing-24);
    text-align: center;
  }

  .footer-bottom p {
    color: var(--color-stone);
    font-size: var(--text-caption);
    margin: 0;
  }

  @media (max-width: 768px) {
    .footer-grid {
      grid-template-columns: 1fr;
      text-align: center;
    }

    .footer-logo,
    .social-links {
      justify-content: center;
    }

    .newsletter-form {
      flex-direction: column;
    }
  }
</style>
