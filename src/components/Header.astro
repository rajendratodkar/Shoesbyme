---
const navItems = [
  { label: 'Home', href: '/' },
  { label: 'About', href: '/about' },
  { label: 'Blog', href: '/blog' },
  { label: 'Size Guide', href: '/size-guide' },
  { label: 'Contact', href: '/contact' },
];
---

<header class="header">
  <div class="container">
    <nav class="nav">
      <a href="/" class="logo">
        <span class="logo-wordmark">ShoesByMe</span>
        <span class="logo-dot" aria-hidden="true"></span>
      </a>

      <ul class="nav-links">
        {navItems.map(item => (
          <li>
            <a href={item.href} class="nav-link">{item.label}</a>
          </li>
        ))}
      </ul>

      <div class="nav-actions">
        <a href="/blog" class="btn btn-primary btn-sm">Subscribe</a>
      </div>

      <button class="mobile-menu-btn" aria-label="Toggle menu" aria-expanded="false" aria-controls="nav-links">
        <span></span>
        <span></span>
        <span></span>
      </button>
    </nav>
  </div>
</header>

<script>
  const btn = document.querySelector('.mobile-menu-btn');
  const navLinks = document.querySelector('.nav-links');
  const navActions = document.querySelector('.nav-actions');
  if (btn && navLinks && navActions) {
    btn.addEventListener('click', () => {
      const expanded = btn.getAttribute('aria-expanded') === 'true';
      btn.setAttribute('aria-expanded', String(!expanded));
      navLinks.classList.toggle('open');
      navActions.classList.toggle('open');
    });
  }
</script>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 100;
    background: var(--color-paper);
    border-bottom: 1px solid var(--color-ink);
  }

  .nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 56px;
  }

  .logo {
    display: flex;
    align-items: center;
    gap: var(--spacing-8);
    text-decoration: none;
    flex-shrink: 0;
  }

  .logo:hover {
    opacity: 0.7;
  }

  .logo-wordmark {
    font-family: var(--font-inter);
    font-weight: 700;
    font-size: 22px;
    text-transform: uppercase;
    letter-spacing: -0.02em;
    color: var(--color-ink);
    line-height: 1;
  }

  .logo-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--color-signal-blue);
    flex-shrink: 0;
  }

  .nav-links {
    display: flex;
    gap: var(--spacing-20);
    list-style: none;
  }

  .nav-link {
    font-family: var(--font-inter);
    font-weight: 500;
    font-size: 15px;
    color: var(--color-ink);
    text-decoration: none;
    padding: var(--spacing-6) 0;
    transition: opacity var(--transition-fast);
  }

  .nav-link:hover {
    opacity: 0.6;
  }

  .nav-actions {
    display: flex;
    align-items: center;
  }

  .mobile-menu-btn {
    display: none;
    flex-direction: column;
    gap: 5px;
    padding: var(--spacing-8);
  }

  .mobile-menu-btn span {
    display: block;
    width: 24px;
    height: 2px;
    background: var(--color-ink);
    transition: all var(--transition-fast);
  }

  @media (max-width: 768px) {
    .nav-links,
    .nav-actions {
      display: none;
    }

    .nav-links.open,
    .nav-actions.open {
      display: flex;
      flex-direction: column;
      position: absolute;
      top: 56px;
      left: 0;
      right: 0;
      background: var(--color-paper);
      padding: var(--spacing-20);
      border-bottom: 1px solid var(--color-ink);
      z-index: 99;
      gap: var(--spacing-16);
    }

    .nav-actions.open {
      position: relative;
      top: auto;
    }

    .mobile-menu-btn {
      display: flex;
    }
  }
</style>
